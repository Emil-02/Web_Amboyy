rules_version = '2';

// Security Rules papan peringkat Astro Dodge.
// Deploy: npx firebase-tools deploy --only firestore:rules
// (Aktifkan juga Authentication → Sign-in method → Anonymous.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function sessionPath() {
      return /databases/$(database)/documents/sessions/$(request.auth.uid);
    }

    // Skor harus masuk akal untuk lama permainan menurut jam SERVER:
    // maks ±250 poin/detik + 500 cadangan (skor * 4 <= ms + 2000).
    function plausible(score) {
      return exists(sessionPath())
        && score * 4 <= request.time.toMillis()
             - get(sessionPath()).data.startedAt.toMillis() + 2000;
    }

    function validEntry(id) {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['name', 'score', 'badges', 'uid', 'updatedAt'])
        && d.keys().hasAll(['name', 'score', 'badges', 'uid', 'updatedAt'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 14
        && d.name.lower() == id
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.badges is list && d.badges.size() <= 7
        && d.badges.hasOnly(['legend', 'multiverse', 'universe', 'galaksi',
                             'pembersih', 'voyager', 'rival'])
        && d.uid == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /leaderboard/{id} {
      allow read: if true;

      allow create: if validEntry(id)
        && plausible(request.resource.data.score);

      allow update: if validEntry(id)
        && request.resource.data.score >= resource.data.score
        && (
          // pemilik nama: boleh menambah lencana, atau skor baru yang wajar
          (resource.data.get('uid', null) == request.auth.uid
            && (request.resource.data.score == resource.data.score
                || plausible(request.resource.data.score)))
          ||
          // nama lama tanpa pemilik: hanya bisa diklaim dengan memecahkan skornya
          (resource.data.get('uid', null) == null
            && request.resource.data.score > resource.data.score
            && plausible(request.resource.data.score))
        );

      allow delete: if false;
    }

    // Waktu mulai permainan (jam server) per pengguna anonim
    match /sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time;
      allow delete: if false;
    }
  }
}
